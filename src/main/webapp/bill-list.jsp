<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Billing & payments");request.setAttribute("nav","billing"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Bill> bills=DAOFactory.getBillDAO().getAllBills();int unpaid=0,ready=0;double due=0,paid=0;Set<Integer> invoiced=new HashSet<>();for(Bill b:bills){invoiced.add(b.getAppointmentId());if("Paid".equals(b.getPaymentStatus()))paid+=b.getAmount();else{due+=b.getAmount();unpaid++;}}for(Appointment a:DAOFactory.getAppointmentDAO().getAllAppointments())if("Completed".equals(a.getStatus())&&!invoiced.contains(a.getAppointmentId()))ready++; %>
<div class="page-heading"><div><div class="eyebrow">CLINIC FINANCES</div><h1>Less paperwork. More clarity.</h1><p>Create invoices for completed visits and record payments.</p></div><div class="heading-actions"><% if(isReception){ %><a class="button primary" href="create-bill.jsp"><%= UI.icon("plus") %>Create invoice</a><% } %></div></div><div class="stats"><div class="stat"><div class="stat-top">Total invoices</div><div class="stat-value"><%= bills.size() %></div><div class="stat-note">Consultation invoices</div></div><div class="stat"><div class="stat-top">Awaiting payment</div><div class="stat-value"><%= unpaid %></div><div class="stat-note"><%= UI.money(due) %> outstanding</div></div><div class="stat"><div class="stat-top">Payments received</div><div class="stat-value" style="font-size:24px"><%= UI.money(paid) %></div><div class="stat-note">All recorded payments</div></div><div class="stat"><div class="stat-top">Ready to invoice</div><div class="stat-value"><%= ready %></div><div class="stat-note">Completed visits without invoices</div></div></div><section class="panel" data-table><div class="panel-head"><h2>Invoices</h2><span class="small-label">CONSULTATION BILLING</span></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search invoice, patient or visit" aria-label="Search invoice, patient or visit"></label><div class="filters"><button class="filter active" type="button" data-filter="all" aria-pressed="true">All invoices</button><button class="filter " type="button" data-filter="Unpaid" aria-pressed="false">Unpaid</button><button class="filter " type="button" data-filter="Paid" aria-pressed="false">Paid</button></div></div><% if(bills.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>No invoices yet.</h3><p>Complete a consultation, then create its invoice. The doctor’s current fee is used when the invoice is created.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Patient</th><th>Amount</th><th>Status</th><th>Payment / actions</th></tr></thead><tbody><% for(Bill b:bills){ %><tr data-row data-status="<%= UI.e(b.getPaymentStatus()) %>"><td><strong>INV-<%= String.format("%05d",b.getBillId()) %></strong><span class="secondary">Visit #<%= b.getAppointmentId() %></span></td><td><%= UI.e(UI.patient(b.getPatientId())) %></td><td class="amount"><%= UI.money(b.getAmount()) %></td><td><%= UI.badge(b.getPaymentStatus()) %></td><td><div class="row-actions"><% if(!"Paid".equals(b.getPaymentStatus())&&isReception){ %><form action="bill" method="post" data-confirm="Confirm that the full payment has been received for this invoice."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="pay"><input type="hidden" name="billId" value="<%= b.getBillId() %>"><select name="paymentMethod" aria-label="Payment method" style="max-width:140px"><option>Cash</option><option>Card</option><option>Bank transfer</option></select><button class="button small primary">Record payment</button></form><% }else{ %><span class="secondary"><%= UI.e(b.getPaymentMethod()) %></span><% } %><a class="button small" href="download-bill?id=<%= b.getBillId() %>" target="_blank" rel="noopener">Print invoice</a></div></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
