<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Reschedule appointment");request.setAttribute("nav","appointments"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% Appointment app=(Appointment)request.getAttribute("appointment");boolean editing=app!=null;if(app==null)app=new Appointment();String selectedPatient=editing?app.getPatientId():request.getParameter("patientId");if(selectedPatient==null)selectedPatient="";String selectedDoctor=editing?app.getDoctorId():"";String selectedDate=editing?app.getAppointmentDate():LocalDate.now().toString(); %>
<div class="page-heading"><div><div class="eyebrow">APPOINTMENTS</div><h1><%= editing?"Reschedule appointment":"Book an appointment" %></h1><p>Choose a patient, a clinician and a published appointment slot.</p></div><div class="heading-actions"><a class="button" href="appointment?action=list">Back to appointments</a></div></div><div class="flow-strip"><span class="current">1 · Patient & doctor</span>→<span>2 · Available time</span>→<span>3 · Confirm booking</span></div><form action="appointment" method="post"><div class="form-grid"><section class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="<%= editing?"update":"insert" %>"><input type="hidden" name="status" value="Booked"><input type="hidden" name="appointmentId" value="<%= app.getAppointmentId() %>"><div class="panel-section"><h3>Patient & care team</h3><div class="form-fields"><div class="field"><label for="patientId">Patient <span>*</span></label><select name="patientId" id="patientId" required><option value="">Choose a registered patient</option><% for(Patient p:DAOFactory.getPatientDAO().getAllPatients()){ %><option value="<%= UI.e(p.getId()) %>" <%= p.getId().equals(selectedPatient)?"selected":"" %>><%= UI.e(p.getName()+" · "+p.getId()) %></option><% } %></select><span class="help">New patient? <a href="add-patient.jsp">Register their profile first.</a></span></div><div class="field"><label for="doctorId">Doctor <span>*</span></label><select name="doctorId" id="doctorId" required><option value="">Choose a doctor</option><% for(Doctor d:DAOFactory.getDoctorDAO().getAllDoctors()){ %><option value="<%= UI.e(d.getId()) %>" <%= d.getId().equals(selectedDoctor)?"selected":"" %>><%= UI.e(d.getName()+" · "+d.getSpecialization()) %></option><% } %></select></div></div></div><div class="panel-section"><h3>Appointment time</h3><div class="field"><label for="appointmentDate">Date <span>*</span></label><input type="date" id="appointmentDate" name="appointmentDate" min="<%= LocalDate.now() %>" value="<%= UI.e(selectedDate) %>" required></div><p class="help mt-20" data-slot-hint aria-live="polite">Choose a doctor and date to see available times.</p><div class="slot-grid" data-slots="slots" data-exclude="<%= app.getAppointmentId() %>" data-selected="<%= editing?UI.e(app.getAppointmentTime().substring(0,5)):"" %>"></div><input type="hidden" name="appointmentTime" value=""></div><div class="panel-section"><div class="field"><label for="reason">Reason for visit <span>*</span></label><textarea name="reason" id="reason" maxlength="255" placeholder="A brief reason for this appointment" required><%= UI.e(app.getReason()) %></textarea><span class="help">Keep detailed clinical notes in the consultation record.</span></div></div><div class="form-actions"><a class="button" href="appointment?action=list">Cancel</a><button class="button primary" type="submit"><%= editing?"Save appointment":"Confirm booking" %><%= UI.icon("arrow") %></button></div></section><aside><div class="panel"><div class="panel-head"><h2>A well-prepared visit</h2></div><div class="panel-body"><h3>Choose an available slot</h3><p>Only times from the doctor’s published schedule are shown. Booked slots are removed automatically.</p><h3>Confirm patient details</h3><p>Check the patient’s name and contact number before booking.</p><h3>On arrival</h3><p class="mb-0">Reception checks the patient in. The clinician can then begin the consultation.</p></div></div><div class="tip"><h3>Can’t find a time?</h3><p>Check the date and the doctor’s sessions under Doctor schedules.</p></div></aside></div></form>
<%@ include file="/WEB-INF/views/foot.jspf" %>
