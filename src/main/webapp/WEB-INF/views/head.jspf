<%@ page pageEncoding="UTF-8" %>
<%
User viewer=(User)session.getAttribute("currentUser");
String base=request.getContextPath();String active=String.valueOf(request.getAttribute("nav"));
boolean isAdmin=UI.admin(viewer),isReception=UI.reception(viewer),isClinical=UI.clinical(viewer);
String pageTitle=String.valueOf(request.getAttribute("pageTitle"));
%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#122e32"><title><%= UI.e(pageTitle) %> · Medicare</title><link rel="icon" href="<%= base %>/assets/mark.svg" type="image/svg+xml"><link rel="stylesheet" href="<%= base %>/assets/app.css"><script src="<%= base %>/assets/app.js" defer></script></head>
<body><a class="skip-link" href="#main">Skip to content</a><div class="scrim" data-close-menu></div>
<aside class="sidebar" id="sidebar"><a class="brand" href="<%= base %>/dashboard.jsp"><span class="brand-mark">+</span><span>medicare<span class="brand-sub">CLINIC WORKSPACE</span></span></a><div class="nav-label">WORKSPACE</div><nav aria-label="Main navigation">
<% String[][] navs={{"dashboard","dashboard.jsp","dashboard","Overview"},{"appointments","appointment?action=list","calendar","Appointments"},{"patients","patient-list.jsp","users","Patients"},{"doctors","list-doctors.jsp","doctor","Doctors"},{"records","medical-record-list.jsp","file","Clinical records"},{"billing","bill-list.jsp","wallet","Billing & payments"}};for(String[] n:navs){ %><a class="nav-item <%= active.equals(n[0])?"active":"" %>" href="<%= base %>/<%= n[1] %>" <%= active.equals(n[0])?"aria-current='page'":"" %>><%= UI.icon(n[2]) %><%= n[3] %></a><% } %>
<div class="nav-label">OPERATIONS</div><a class="nav-item <%= active.equals("availability")?"active":"" %>" href="<%= base %>/availability"><%= UI.icon("clock") %>Doctor schedules</a><a class="nav-item <%= active.equals("documents")?"active":"" %>" href="<%= base %>/patient-documents.jsp"><%= UI.icon("file") %>Documents</a><a class="nav-item <%= active.equals("claims")?"active":"" %>" href="<%= base %>/insurance-claims.jsp"><%= UI.icon("wallet") %>Insurance claims</a>
<% if(isAdmin){ %><div class="nav-label">ADMINISTRATION</div><a class="nav-item <%= active.equals("users")?"active":"" %>" href="<%= base %>/users"><%= UI.icon("users") %>Team & access</a><a class="nav-item <%= active.equals("audit")?"active":"" %>" href="<%= base %>/audit-logs.jsp"><%= UI.icon("file") %>Activity log</a><a class="nav-item <%= active.equals("settings")?"active":"" %>" href="<%= base %>/settings.jsp"><%= UI.icon("settings") %>Settings</a><% } %>
</nav><div class="sidebar-bottom"><span class="live-dot"></span> Clinic workspace <small><%= UI.e(ClinicSettings.get("name")) %></small></div></aside>
<div class="workspace"><header class="topbar"><div class="topbar-left"><button class="icon-button menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">☰</button><span class="breadcrumb">Workspace <span>/</span> <strong><%= UI.e(pageTitle) %></strong></span></div><div class="topbar-right"><span class="today-label"><%= LocalDate.now().format(java.time.format.DateTimeFormatter.ofPattern("EEE, dd MMM")) %></span><span class="storage-chip"><span></span><%= "DB".equals(DAOFactory.getStorageMode())?"MySQL":"File storage" %></span><a class="account" href="<%= base %>/change-password.jsp"><span class="avatar"><%= UI.e(UI.initials(viewer.getName()==null?viewer.getUsername():viewer.getName())) %></span><span><strong><%= UI.e(viewer.getUsername()) %></strong><small><%= "STAFF".equals(viewer.getRole())?"Reception":UI.e(viewer.getRole()) %></small></span></a><a href="<%= base %>/logout" class="icon-button" aria-label="Sign out" title="Sign out"><%= UI.icon("logout") %></a></div></header>
<main id="main" class="page-content">
<% Object flash=session.getAttribute("flash");if(flash!=null){session.removeAttribute("flash"); %><div class="notice success" role="status"><%= UI.icon("check") %><%= UI.e(flash) %><button type="button" aria-label="Dismiss" data-dismiss>×</button></div><% } %>
<% if(request.getAttribute("errorMessage")!=null){ %><div class="notice danger" role="alert"><%= UI.e(request.getAttribute("errorMessage")) %></div><% } %>
<% if(request.getParameter("error")!=null){ %><div class="notice danger" role="alert">The action was not completed. Please check the details and try again. <%= UI.e(request.getParameter("error")) %></div><% } %>
<% if(request.getParameter("success")!=null||request.getParameter("status")!=null&&Arrays.asList("saved","added","updated","deleted","success").contains(request.getParameter("status"))||request.getParameter("msg")!=null){ %><div class="notice success" role="status">Your change has been saved.<button type="button" aria-label="Dismiss" data-dismiss>×</button></div><% } %>
