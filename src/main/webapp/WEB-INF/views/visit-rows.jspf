<%@ page pageEncoding="UTF-8" %>
<% for(Appointment a:visits){ %><tr data-row data-status="<%= UI.e(a.getStatus()) %>"><td><div class="person"><span class="avatar"><%= UI.e(UI.initials(a.getPatientName())) %></span><span><strong><a href="patient?action=view&id=<%= java.net.URLEncoder.encode(a.getPatientId(),"UTF-8") %>"><%= UI.e(a.getPatientName()) %></a></strong><small>Visit #<%= String.format("%04d",a.getAppointmentId()) %></small></span></div></td><td><%= UI.e(a.getDoctorName()) %><span class="secondary"><%= UI.e(a.getDoctorSpecialization()) %></span></td><td><%= UI.e(UI.time(a.getAppointmentTime())) %><span class="secondary"><%= UI.e(UI.date(a.getAppointmentDate())) %></span></td><td><%= UI.badge(a.getStatus()) %></td><td><div class="row-actions">
<% if("Booked".equals(a.getStatus())&&isReception){ %><form action="visit" method="post"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><input type="hidden" name="status" value="Checked-in"><button class="button small soft">Check in</button></form><a class="button small" href="appointment?action=edit&id=<%= a.getAppointmentId() %>">Edit</a><% } %>
<% if("Checked-in".equals(a.getStatus())&&isClinical){ %><form action="visit" method="post"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><input type="hidden" name="status" value="In consultation"><button class="button small primary">Start visit</button></form><% } %>
<% if("In consultation".equals(a.getStatus())&&isClinical){ %><a class="button small" href="medical-record?action=new&appointmentId=<%= a.getAppointmentId() %>">Clinical note</a><form action="visit" method="post"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><input type="hidden" name="status" value="Completed"><button class="button small primary">Complete</button></form><% } %>
<% if("Completed".equals(a.getStatus())&&isReception){boolean billed=false;for(Bill invoice:DAOFactory.getBillDAO().getAllBills())if(invoice.getAppointmentId()==a.getAppointmentId())billed=true;if(!billed){ %><a class="button small soft" href="create-bill.jsp?appointmentId=<%= a.getAppointmentId() %>">Create invoice</a><% }else{ %><a class="text-link" href="bill-list.jsp">View billing</a><% }} %>
<% if(Arrays.asList("Booked","Checked-in").contains(a.getStatus())&&isReception){ %><a class="button small" href="appointment?action=confirm-cancel&id=<%= a.getAppointmentId() %>">Cancel</a><% } %>
<% if("Booked".equals(a.getStatus())&&isReception&&!LocalDate.parse(a.getAppointmentDate()).isAfter(LocalDate.now())){ %><form action="visit" method="post"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><input type="hidden" name="status" value="No-show"><button class="button small soft">No-show</button></form><% } %>
<% if(isAdmin&&Arrays.asList("Cancelled","No-show").contains(a.getStatus())){ %><form action="appointment" method="post" data-confirm="Delete this appointment? Referenced visits cannot be deleted."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><button class="button small danger">Delete</button></form><% } %>
</div></td></tr><% } %>