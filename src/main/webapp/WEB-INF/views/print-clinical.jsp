<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.medicare.model.*,com.medicare.util.*" %>
<% MedicalRecord value=(MedicalRecord)request.getAttribute("clinical"); %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Clinical · Medicare</title><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/app.css"><style>body{background:#f5f7f7}.paper{max-width:780px;margin:45px auto;padding:55px;background:white;border:1px solid #e5eaea;border-radius:15px}.paper-brand{display:flex;justify-content:space-between;padding-bottom:25px;border-bottom:2px solid #137d73;margin-bottom:30px}.paper h1{font-size:27px}.paper .detail-grid{margin:28px 0}.paper .clinical-note{border:1px solid #e5eaea;padding:18px;border-radius:8px;min-height:80px}.paper .amount-summary{margin-top:32px}.paper-foot{border-top:1px solid #e5eaea;margin-top:35px;padding-top:18px;font-size:11px;color:#8c9b93}.print-actions{max-width:780px;margin:25px auto;display:flex;justify-content:flex-end}.paper p{font-size:12px}@media print{.paper{border:0;margin:0;padding:10px;max-width:none}.print-actions{display:none}body{background:white}}@media(max-width:700px){.paper{padding:25px;margin:20px}.print-actions{margin:20px}.paper-brand{flex-direction:column;gap:15px}}</style></head><body><div class="print-actions"><button class="button primary" onclick="window.print()">Print / Save as PDF</button></div><main class="paper"><div class="paper-brand"><div><div class="eyebrow">MEDICARE · CLINIC WORKSPACE</div><h1><%= UI.e(ClinicSettings.get("name")) %></h1><p class="mb-0"><%= UI.e(ClinicSettings.get("address")) %><br><%= UI.e(ClinicSettings.get("phone")) %></p></div><div class="text-right"><div class="small-label">CLINICAL NOTE</div><h2>REC-<%= String.format("%05d",value.getRecordId()) %></h2></div></div><dl class="detail-grid"><div><dt>Patient</dt><dd><%= UI.e(UI.patient(value.getPatientId())) %></dd></div><div><dt>Clinician</dt><dd><%= UI.e(UI.doctor(value.getDoctorId())) %></dd></div><div><dt>Recorded</dt><dd><%= UI.e(UI.date(value.getRecordDate())) %></dd></div></dl><h3>Assessment / diagnosis</h3><p class="clinical-note"><%= UI.e(value.getDiagnosis()) %></p><h3>Prescription / care instructions</h3><p class="clinical-note"><%= UI.e(value.getPrescription()) %></p><h3>Additional notes</h3><p class="clinical-note"><%= UI.e(value.getNotes()) %></p><p class="text-right" style="margin-top:45px">____________________________<br>Clinician signature</p><div class="paper-foot">Medicare · A record of your clinic visit. Keep this document for your records.</div></main></body></html>