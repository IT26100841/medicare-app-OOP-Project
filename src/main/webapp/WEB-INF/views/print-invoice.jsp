<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.medicare.model.*,com.medicare.util.*" %>
<% Bill value=(Bill)request.getAttribute("invoice"); %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Invoice · Medicare</title><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/app.css"><style>body{background:#f5f7f7}.paper{max-width:780px;margin:45px auto;padding:55px;background:white;border:1px solid #e5eaea;border-radius:15px}.paper-brand{display:flex;justify-content:space-between;padding-bottom:25px;border-bottom:2px solid #137d73;margin-bottom:30px}.paper h1{font-size:27px}.paper .detail-grid{margin:28px 0}.paper .clinical-note{border:1px solid #e5eaea;padding:18px;border-radius:8px;min-height:80px}.paper .amount-summary{margin-top:32px}.paper-foot{border-top:1px solid #e5eaea;margin-top:35px;padding-top:18px;font-size:11px;color:#8c9b93}.print-actions{max-width:780px;margin:25px auto;display:flex;justify-content:flex-end}.paper p{font-size:12px}@media print{.paper{border:0;margin:0;padding:10px;max-width:none}.print-actions{display:none}body{background:white}}@media(max-width:700px){.paper{padding:25px;margin:20px}.print-actions{margin:20px}.paper-brand{flex-direction:column;gap:15px}}</style></head><body><div class="print-actions"><button class="button primary" onclick="window.print()">Print / Save as PDF</button></div><main class="paper"><div class="paper-brand"><div><div class="eyebrow">MEDICARE · CLINIC WORKSPACE</div><h1><%= UI.e(ClinicSettings.get("name")) %></h1><p class="mb-0"><%= UI.e(ClinicSettings.get("address")) %><br><%= UI.e(ClinicSettings.get("phone")) %></p></div><div class="text-right"><div class="small-label">CONSULTATION INVOICE</div><h2>INV-<%= String.format("%05d",value.getBillId()) %></h2></div></div><dl class="detail-grid"><div><dt>Patient</dt><dd><%= UI.e(UI.patient(value.getPatientId())) %></dd></div><div><dt>Appointment</dt><dd>#<%= value.getAppointmentId() %></dd></div><div><dt>Payment status</dt><dd><%= UI.badge(value.getPaymentStatus()) %></dd></div></dl><table><thead><tr><th>Description</th><th class="text-right">Amount</th></tr></thead><tbody><tr><td>Consultation fee<span class="secondary">Visit #<%= value.getAppointmentId() %></span></td><td class="text-right amount"><%= UI.money(value.getAmount()) %></td></tr></tbody></table><div class="amount-summary"><span>Total amount</span><strong><%= UI.money(value.getAmount()) %></strong></div><p>Payment method: <%= UI.e(value.getPaymentMethod()) %><br><%= "Paid".equals(value.getPaymentStatus())?"Payment received. Thank you.":"Payment is outstanding. This invoice is not a payment receipt." %></p><div class="paper-foot">Medicare · A record of your clinic visit. Keep this document for your records.</div></main></body></html>