<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Team member");request.setAttribute("nav","users"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% User u=(User)request.getAttribute("user");boolean editing=u!=null;if(u==null){u=new User();u.setRole("STAFF");}String linked=editing?ClinicStore.doctorFor(u.getId()):null; %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1><%= editing?"Edit team access":"Add a team member" %></h1><p>Give each person their own account and the access their role needs.</p></div><div class="heading-actions"><a class="button" href="users">Back to team</a></div></div><form action="users" method="post"><div class="form-grid"><section class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="<%= editing?"update":"insert" %>"><input type="hidden" name="id" value="<%= u.getId() %>"><div class="panel-body"><div class="form-fields"><div class="field"><label for="username">Username</label><input id="username" name="username" value="<%= UI.e(u.getUsername()) %>" maxlength="50" <%= editing?"readonly":"required" %>></div><div class="field"><label for="email">Email</label><input type="email" id="email" name="email" maxlength="100" value="<%= UI.e(u.getEmail()) %>"></div><div class="field full"><label for="password">Password <%= editing?"(leave blank to keep current)":"" %></label><input type="password" id="password" name="password" minlength="8" autocomplete="new-password" <%= editing?"":"required" %>><span class="help">At least eight characters. Passwords are stored as salted hashes.</span></div><div class="field"><label for="role">Role</label><select id="role" name="role" data-user-role><% for(String role:new String[]{"ADMIN","DOCTOR","STAFF"}){ %><option value="<%= role %>" <%= role.equals(u.getRole())?"selected":"" %>><%= role.equals("STAFF")?"Reception / staff":role.equals("DOCTOR")?"Doctor":"Administrator" %></option><% } %></select></div><div class="field" data-doctor-link><label for="doctorId">Doctor profile</label><select name="doctorId" id="doctorId"><option value="">Not linked yet</option><% for(Doctor d:DAOFactory.getDoctorDAO().getAllDoctors()){ %><option value="<%= UI.e(d.getId()) %>" <%= Objects.equals(d.getId(),linked)?"selected":"" %>><%= UI.e(d.getName()) %></option><% } %></select><span class="help">Doctors only work on visits assigned to this profile.</span></div></div></div><div class="form-actions"><a class="button" href="users">Cancel</a><button class="button primary">Save team member</button></div></section><aside><div class="panel"><div class="panel-head"><h2>Role guide</h2></div><div class="panel-body"><h3>Administrator</h3><p>Clinic configuration, users and all hospital operations.</p><h3>Reception</h3><p>Patient registration, appointments, arrivals, invoices and payments.</p><h3>Doctor</h3><p class="mb-0">Assigned consultation queue, clinical notes and visit completion.</p></div></div></aside></div></form>
<%@ include file="/WEB-INF/views/foot.jspf" %>
