<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Overview");request.setAttribute("nav","dashboard"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Appointment> allVisits=UI.visibleAppointments(viewer),todayVisits=new ArrayList<>();int waiting=0,booked=0,unpaid=0;double outstanding=0;for(Appointment a:allVisits)if(LocalDate.parse(a.getAppointmentDate()).equals(LocalDate.now())){todayVisits.add(a);if("Checked-in".equals(a.getStatus()))waiting++;if("Booked".equals(a.getStatus()))booked++;}for(Bill b:DAOFactory.getBillDAO().getAllBills())if(!"Paid".equals(b.getPaymentStatus())){unpaid++;outstanding+=b.getAmount();}List<Appointment> visits=todayVisits; %>
<div class="page-heading"><div><div class="eyebrow">YOUR CLINIC, AT A GLANCE</div><h1>Good <%= LocalTime.now().getHour()<12?"morning":LocalTime.now().getHour()<17?"afternoon":"evening" %>, <%= UI.e(viewer.getUsername()) %>.</h1><p>Here is what is happening at your clinic today.</p></div><div class="heading-actions"><% if(isReception){ %><a class="button primary" href="appointment?action=new"><%= UI.icon("plus") %>Book appointment</a><% } %></div></div>
<div class="stats"><div class="stat"><div class="stat-top">Today’s appointments<span class="stat-symbol"><%= UI.icon("calendar") %></span></div><div class="stat-value"><%= todayVisits.size() %></div><div class="stat-note"><strong><%= booked %> booked</strong> · across today’s schedule</div></div><div class="stat"><div class="stat-top">Waiting for consultation<span class="stat-symbol"><%= UI.icon("clock") %></span></div><div class="stat-value"><%= waiting %></div><div class="stat-note">Checked in and ready for a clinician</div></div><div class="stat"><div class="stat-top">Registered patients<span class="stat-symbol"><%= UI.icon("users") %></span></div><div class="stat-value"><%= DAOFactory.getPatientDAO().getAllPatients().size() %></div><div class="stat-note">Your patient directory, in one place</div></div><div class="stat"><div class="stat-top">Outstanding invoices<span class="stat-symbol"><%= UI.icon("wallet") %></span></div><div class="stat-value"><%= unpaid %></div><div class="stat-note"><strong><%= UI.money(outstanding) %></strong> awaiting payment</div></div></div>
<div class="dashboard-grid"><div><section class="panel" data-table><div class="panel-head"><div><h2>Today’s appointments <span class="count"><%= todayVisits.size() %></span></h2><p>A clear view of your day, one patient at a time.</p></div><a class="text-link" href="appointment?action=list">View all <%= UI.icon("arrow") %></a></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search today’s appointments" aria-label="Search today’s appointments"></label><div class="filters"><button class="filter active" type="button" data-filter="all" aria-pressed="true">All visits</button><button class="filter " type="button" data-filter="Checked-in" aria-pressed="false">Waiting</button><button class="filter " type="button" data-filter="Completed" aria-pressed="false">Completed</button></div></div><% if(visits.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>A little breathing room.</h3><p>No appointments are scheduled for today. Book a visit or browse the full appointment calendar.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Date & time</th><th>Status</th><th>Next step</th></tr></thead><tbody><%@ include file="/WEB-INF/views/visit-rows.jspf" %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<section class="panel"><div class="panel-head"><div><h2>Care, without the loose ends</h2><p>Keep each visit moving through the clinic.</p></div><%= UI.icon("doctor") %></div><div class="panel-body"><div class="flow-strip"><span>Book appointment</span>→<span>Check in</span>→<span>Consultation</span>→<span>Clinical note</span>→<span>Complete</span>→<span>Invoice & pay</span></div><p class="mb-0" style="font-size:11px">Reception manages arrivals. Clinicians record the consultation. Billing becomes available when care is complete.</p></div></section></div>
<aside class="right-column"><section class="panel"><div class="panel-head"><h2>Quick actions</h2><span class="small-label">EVERYDAY TOOLS</span></div><div class="panel-body">
<% if(isReception){ %><a class="quick-action" href="add-patient.jsp"><span class="action-icon"><%= UI.icon("users") %></span><span class="action-copy"><strong>Register a patient</strong><small>Start a new patient profile</small></span><%= UI.icon("arrow") %></a><a class="quick-action" href="appointment?action=new"><span class="action-icon"><%= UI.icon("calendar") %></span><span class="action-copy"><strong>Book an appointment</strong><small>Find the right doctor and time</small></span><%= UI.icon("arrow") %></a><a class="quick-action" href="bill-list.jsp"><span class="action-icon"><%= UI.icon("wallet") %></span><span class="action-copy"><strong>Review payments</strong><small>Invoices and outstanding balances</small></span><%= UI.icon("arrow") %></a><% }else{ %><a class="quick-action" href="appointment?action=list"><span class="action-icon"><%= UI.icon("doctor") %></span><span class="action-copy"><strong>Open my queue</strong><small>Start a checked-in consultation</small></span><%= UI.icon("arrow") %></a><a class="quick-action" href="medical-record-list.jsp"><span class="action-icon"><%= UI.icon("file") %></span><span class="action-copy"><strong>Clinical records</strong><small>Review your consultation notes</small></span><%= UI.icon("arrow") %></a><% } %></div></section>
<section class="panel"><div class="panel-head"><h2>Next on the schedule</h2><%= UI.icon("clock") %></div><div class="panel-body"><% int shown=0;for(Appointment a:allVisits){if(shown>=3)break;if(LocalDate.parse(a.getAppointmentDate()).isBefore(LocalDate.now())||Arrays.asList("Completed","Cancelled","No-show").contains(a.getStatus()))continue;shown++; %><div class="schedule-item"><span class="schedule-time"><%= UI.e(a.getAppointmentTime().substring(0,5)) %></span><span class="schedule-detail"><strong><%= UI.e(a.getPatientName()) %></strong><small><%= UI.e(a.getDoctorName()) %><br><%= UI.e(UI.date(a.getAppointmentDate())) %></small></span></div><% }if(shown==0){ %><p class="mb-0" style="font-size:11px">No upcoming appointments.</p><% } %></div></section><div class="tip"><h3>Good care starts with good records.</h3><p>Confirm patient contact details and allergies before each consultation.</p></div></aside></div>
<%@ include file="/WEB-INF/views/foot.jspf" %>
