<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Patient registration");request.setAttribute("nav","patients"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% Patient p=(Patient)request.getAttribute("patient");boolean editing=p!=null;if(p==null)p=new Patient(); %>
<div class="page-heading"><div><div class="eyebrow">PATIENT DIRECTORY</div><h1><%= editing?"Edit patient profile":"Register a patient" %></h1><p>The right information helps your care team prepare for every visit.</p></div><div class="heading-actions"><a class="button" href="patient-list.jsp">Back to patients</a></div></div><form action="<%= editing?"edit-patient":"add-patient" %>" method="post"><div class="form-grid"><section class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= UI.e(p.getId()) %>"><div class="panel-section"><h3>Personal & contact details</h3><div class="form-fields"><div class="field full"><label for="name">Full name <span>*</span></label><input id="name" name="name" value="<%= UI.e(p.getName()) %>" maxlength="100" placeholder="Patient’s full name" autocomplete="name" required></div><div class="field"><label for="age">Age <span>*</span></label><input type="number" id="age" name="age" min="0" max="120" value="<%= editing?String.valueOf(p.getAge()):"" %>" required></div><div class="field"><label for="gender">Gender <span>*</span></label><select id="gender" name="gender" required><option value="">Choose gender</option><% for(String g:new String[]{"Male","Female","Other"}){ %><option <%= g.equals(p.getGender())?"selected":"" %>><%= g %></option><% } %></select></div><div class="field"><label for="contact">Contact number <span>*</span></label><input id="contact" name="<%= editing?"contact":"phone" %>" type="tel" maxlength="20" autocomplete="tel" placeholder="07X XXX XXXX" value="<%= UI.e(p.getContact()) %>" required></div><div class="field"><label for="email">Email address</label><input id="email" type="email" name="email" autocomplete="email" value="<%= UI.e(p.getEmail()) %>" maxlength="100" placeholder="patient@example.com"></div><div class="field full"><label for="address">Address</label><textarea id="address" name="address" autocomplete="street-address" placeholder="Street, town and city"><%= UI.e(p.getAddress()) %></textarea></div></div></div><div class="panel-section"><h3>Clinical background</h3><div class="form-fields"><div class="field"><label for="bloodGroup">Blood group</label><select id="bloodGroup" name="<%= editing?"bloodGroup":"blood_group" %>"><option value="">Not recorded</option><% for(String group:new String[]{"A+","A-","B+","B-","AB+","AB-","O+","O-"}){ %><option <%= group.equals(p.getBloodGroup())?"selected":"" %>><%= group %></option><% } %></select></div><div class="field"><label for="allergies">Known allergies</label><input id="allergies" name="allergies" value="<%= UI.e(p.getAllergies()) %>" placeholder="Record known allergies or none"></div><div class="field full"><label for="history">Medical history</label><textarea id="history" name="<%= editing?"medicalHistory":"medical_history" %>" placeholder="Relevant history shared by the patient"><%= UI.e(p.getMedicalHistory()) %></textarea></div></div></div><div class="form-actions"><a class="button" href="patient-list.jsp">Cancel</a><button class="button primary"><%= editing?"Save changes":"Register patient" %></button></div></section><aside><div class="tip"><h3>One profile. A clearer history.</h3><p>Search the patient directory before creating a new profile. Confirm contact details and allergies with the patient.</p></div><p class="page-note">Required fields are marked with an asterisk. Clinical information should be entered by an authorised member of the care team.</p></aside></div></form>
<%@ include file="/WEB-INF/views/foot.jspf" %>
