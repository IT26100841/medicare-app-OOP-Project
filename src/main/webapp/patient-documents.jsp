<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Documents");request.setAttribute("nav","documents"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>

<div class="page-heading"><div><div class="eyebrow">PATIENT DOCUMENTS</div><h1>Every report, in the right place.</h1><p>Attach PDF and image documents to a registered patient.</p></div><div class="heading-actions"></div></div><div class="form-grid"><section class="panel" data-table><div class="panel-head"><h2>Document library</h2><span class="small-label">PATIENT FILES</span></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search patient or document name" aria-label="Search patient or document name"></label><div class="filters"></div></div><div class="table-wrap"><table><thead><tr><th>Document</th><th>Patient</th><th>Uploaded</th><th>Action</th></tr></thead><tbody><% boolean any=false;try(java.sql.ResultSet rs=PortalData.query("patient_documents")){while(rs.next()){if(request.getParameter("patientId")!=null&&!request.getParameter("patientId").equals(rs.getString("patient_id")))continue;any=true; %><tr data-row><td><strong><%= UI.e(rs.getString("file_name")) %></strong><span class="secondary">Document #<%= rs.getInt("document_id") %></span></td><td><%= UI.e(UI.patient(rs.getString("patient_id"))) %></td><td><%= UI.e(rs.getTimestamp("uploaded_at").toLocalDateTime().toLocalDate()) %></td><td><a class="button small" href="view-document?id=<%= rs.getInt("document_id") %>">Download</a></td></tr><% }} %></tbody></table></div><% if(!any){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>A home for patient reports.</h3><p>Upload a PDF, JPEG or PNG and link it to the correct patient.</p></div><% } %><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div></section><aside><form action="upload-document" method="post" enctype="multipart/form-data" class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><div class="panel-head"><h2>Upload a document</h2></div><div class="panel-body stack"><div class="field"><label for="patientId">Patient</label><select name="patientId" id="patientId" required><option value="">Choose patient</option><% for(Patient p:DAOFactory.getPatientDAO().getAllPatients()){ %><option value="<%= UI.e(p.getId()) %>" <%= p.getId().equals(request.getParameter("patientId"))?"selected":"" %>><%= UI.e(p.getName()) %></option><% } %></select></div><div class="field"><label for="document">Report or scan</label><input type="file" name="file" id="document" accept=".pdf,.png,.jpg,.jpeg" required><span class="help">PDF, PNG or JPEG. Maximum file size: 20 MB.</span></div><button class="button primary">Upload document</button></div></form><div class="tip"><h3>Check the patient before uploading.</h3><p>Duplicate filenames are stored separately. Downloads use a registered document ID.</p></div></aside></div>
<%@ include file="/WEB-INF/views/foot.jspf" %>
