<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Account security");request.setAttribute("nav","account"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>

<div class="page-heading"><div><div class="eyebrow">YOUR ACCOUNT</div><h1>Update your password.</h1><p>Choose a password with at least eight characters.</p></div><div class="heading-actions"></div></div><% if(request.getAttribute("successMessage")!=null){ %><div class="notice success"><%= UI.e(request.getAttribute("successMessage")) %></div><% } %><form action="change-password" method="post" class="panel" style="max-width:650px"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><div class="panel-body stack"><div class="field"><label for="currentPassword">Current password</label><input type="password" name="currentPassword" id="currentPassword" autocomplete="current-password" required></div><div class="field"><label for="newPassword">New password</label><input type="password" name="newPassword" id="newPassword" minlength="8" autocomplete="new-password" required></div><div class="field"><label for="confirmPassword">Confirm new password</label><input type="password" name="confirmPassword" id="confirmPassword" minlength="8" autocomplete="new-password" required></div></div><div class="form-actions"><button class="button primary">Update password</button></div></form>
<%@ include file="/WEB-INF/views/foot.jspf" %>
