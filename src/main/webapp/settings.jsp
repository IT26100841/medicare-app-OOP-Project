<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Settings");request.setAttribute("nav","settings"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>

<div class="page-heading"><div><div class="eyebrow">WORKSPACE SETTINGS</div><h1>A workspace that fits your clinic.</h1><p>Manage your clinic identity and choose where this application stores its records.</p></div><div class="heading-actions"></div></div><form action="settings" method="post"><div class="form-grid"><section class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><div class="panel-section"><h3>Clinic identity</h3><div class="form-fields"><div class="field"><label for="hospitalName">Clinic name</label><input id="hospitalName" name="hospitalName" value="<%= UI.e(ClinicSettings.get("name")) %>" required></div><div class="field"><label for="contactNumber">Contact number</label><input id="contactNumber" name="contactNumber" value="<%= UI.e(ClinicSettings.get("phone")) %>" required></div><div class="field full"><label for="address">Address</label><textarea id="address" name="address" required><%= UI.e(ClinicSettings.get("address")) %></textarea></div></div></div><div class="panel-section"><h3>Record storage</h3><label class="radio-card"><input type="radio" name="storageMode" value="DB" <%= "DB".equals(DAOFactory.getStorageMode())?"checked":"" %>><span><strong>MySQL database</strong><small>Use the configured MySQL connection for hospital records.</small></span></label><label class="radio-card"><input type="radio" name="storageMode" value="FILE" <%= "FILE".equals(DAOFactory.getStorageMode())?"checked":"" %>><span><strong>Local file storage</strong><small>Use UTF-8 text files in the configured application data directory.</small></span></label><div class="notice info">Switching storage signs everyone out on their next request. Records are not copied between backends. Sign in with an account from the selected backend.</div><p class="help">The MySQL connection is checked before enabling DB mode. Connection credentials belong in server configuration, not in this form.</p></div><div class="form-actions"><button class="button primary">Save settings</button></div></section><aside><div class="tip"><h3>One workspace, one active backend.</h3><p>This setting applies to the entire application. File and MySQL records remain separate. Keep the selected backend consistent while the clinic is in use.</p></div><% if(System.getProperty("medicare.storage")!=null){ %><div class="notice info mt-20">A server startup option currently forces <%= UI.e(System.getProperty("medicare.storage")) %> on restart. Remove -Dmedicare.storage to keep the selection made here.</div><% } %></aside></div></form>
<%@ include file="/WEB-INF/views/foot.jspf" %>
