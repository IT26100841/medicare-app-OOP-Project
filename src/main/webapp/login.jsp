<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.medicare.util.*" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Medicare</title><link rel="stylesheet" href="assets/app.css"><link rel="icon" href="assets/mark.svg"></head><body><main class="login-page"><section class="login-story"><a class="brand" href="login.jsp"><span class="brand-mark">+</span><span>medicare<span class="brand-sub">CLINIC WORKSPACE</span></span></a><div><div class="eyebrow" style="color:#91cbb4">MADE FOR THE PEOPLE WHO CARE</div><h1>A calmer day.<br><em>Better-connected care.</em></h1><p>Bring appointments, patient records and everyday clinic operations into one thoughtful workspace.</p><div class="story-graphic" aria-hidden="true"><div></div><div></div><div></div><div></div></div></div><div class="story-bottom">PATIENTS FIRST. EVERY VISIT, EVERY DAY.</div></section><section class="login-form-side"><div class="login-form-box"><div class="eyebrow">WELCOME BACK</div><h2>Sign in to your workspace.</h2><p>Use your clinic account to continue.</p><% if(request.getParameter("error")!=null){ %><div class="notice danger" role="alert">Could not sign in. Check your username, password and server connection.</div><% }if(request.getParameter("switched")!=null){ %><div class="notice info">The storage backend changed. Sign in with an account from the selected backend.</div><% } %><form action="login" method="post"><input type="hidden" name="csrfToken" value="<%= Html.escape(session.getAttribute("csrfToken")) %>"><div class="field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" placeholder="Enter your username" required autofocus></div><div class="field"><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required></div><button class="button primary">Sign in <%= UI.icon("arrow") %></button></form><div class="login-foot">Clinic team access only. <a href="portal">Patient portal →</a></div></div></section></main></body></html>