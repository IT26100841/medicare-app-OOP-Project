<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Doctors");request.setAttribute("nav","doctors"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Doctor> doctors=DAOFactory.getDoctorDAO().getAllDoctors(); %>
<div class="page-heading"><div><div class="eyebrow">CARE TEAM</div><h1>Meet your clinical team.</h1><p>Doctor profiles, consultation fees and published sessions.</p></div><div class="heading-actions"><% if(isAdmin){ %><a class="button primary" href="add-doctor.jsp"><%= UI.icon("plus") %>Add doctor</a><% } %></div></div><section class="panel" data-table><div class="panel-head"><h2>Doctor directory <span class="count"><%= doctors.size() %></span></h2><a class="text-link" href="availability">View schedules <%= UI.icon("arrow") %></a></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search doctor or speciality" aria-label="Search doctor or speciality"></label><div class="filters"></div></div><% if(doctors.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>Build your care team.</h3><p>Add a doctor profile and publish their availability before booking visits.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Doctor</th><th>Speciality</th><th>Contact</th><th>Consultation fee</th><th>Actions</th></tr></thead><tbody><% for(Doctor d:doctors){ %><tr data-row><td><div class="person"><span class="avatar blue"><%= UI.e(UI.initials(d.getName())) %></span><span><strong><%= UI.e(d.getName()) %></strong><small><%= UI.e(d.getId()) %></small></span></div></td><td><%= UI.e(d.getSpecialization()) %><span class="secondary"><%= UI.e(d.getQualification()) %></span></td><td><%= UI.e(d.getPhone()) %><span class="secondary"><%= UI.e(d.getEmail()) %></span></td><td class="amount"><%= UI.money(d.getConsultationFee()) %></td><td><div class="row-actions"><a class="button small" href="doctor?action=view&id=<%= java.net.URLEncoder.encode(d.getId(),"UTF-8") %>">View profile</a><% if(isAdmin){ %><a class="button small" href="doctor?action=edit&id=<%= java.net.URLEncoder.encode(d.getId(),"UTF-8") %>">Edit</a><form action="doctor" method="post" data-confirm="Delete this doctor profile? Referenced profiles cannot be deleted."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%= UI.e(d.getId()) %>"><button class="button small danger">Delete</button></form><% } %></div></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
