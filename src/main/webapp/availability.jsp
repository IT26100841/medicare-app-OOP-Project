<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Doctor schedules");request.setAttribute("nav","availability"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Availability> schedules=new ScheduleService().list();Availability editing=null;if(request.getParameter("edit")!=null)for(Availability a:schedules)if(a.getId()==Integer.parseInt(request.getParameter("edit")))editing=a; %>
<div class="page-heading"><div><div class="eyebrow">CLINIC SESSIONS</div><h1>A schedule that works for everyone.</h1><p>Publish weekly sessions. Available appointment times are generated automatically.</p></div><div class="heading-actions"></div></div><div class="form-grid"><section class="panel" data-table><div class="panel-head"><h2>Published sessions <span class="count"><%= schedules.size() %></span></h2></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search doctor or day" aria-label="Search doctor or day"></label><div class="filters"></div></div><% if(schedules.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>No sessions published yet.</h3><p>An administrator can add a weekly session using the form on this page.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Doctor</th><th>Day</th><th>Session</th><th>Slot length</th><th>Actions</th></tr></thead><tbody><% for(Availability a:schedules){ %><tr data-row><td><strong><%= UI.e(UI.doctor(a.getDoctorId())) %></strong></td><td><%= UI.e(DayOfWeek.of(a.getDayOfWeek()).getDisplayName(java.time.format.TextStyle.FULL,Locale.ENGLISH)) %></td><td><%= UI.e(UI.time(a.getStartTime())) %> – <%= UI.e(UI.time(a.getEndTime())) %></td><td><%= a.getSlotMinutes() %> min</td><td><% if(isAdmin){ %><div class="row-actions"><a class="button small" href="availability?edit=<%= a.getId() %>">Edit</a><form action="availability" method="post" data-confirm="Remove this published session? Existing appointments are kept; review them before changing clinic hours."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input name="action" type="hidden" value="delete"><input type="hidden" name="id" value="<%= a.getId() %>"><button class="button small danger">Remove</button></form></div><% } %></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section><aside><% if(isAdmin){ %><form action="availability" method="post" class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= editing==null?0:editing.getId() %>"><div class="panel-head"><h2><%= editing==null?"Add a clinic session":"Edit clinic session" %></h2></div><div class="panel-body stack"><div class="field"><label for="doctorId">Doctor</label><select name="doctorId" id="doctorId" required><option value="">Choose doctor</option><% for(Doctor d:DAOFactory.getDoctorDAO().getAllDoctors()){ %><option value="<%= UI.e(d.getId()) %>" <%= editing!=null&&d.getId().equals(editing.getDoctorId())?"selected":"" %>><%= UI.e(d.getName()) %></option><% } %></select></div><div class="field"><label for="dayOfWeek">Day of week</label><select name="dayOfWeek" id="dayOfWeek"><% for(DayOfWeek day:DayOfWeek.values()){ %><option value="<%= day.getValue() %>" <%= editing!=null&&editing.getDayOfWeek()==day.getValue()?"selected":"" %>><%= day.getDisplayName(java.time.format.TextStyle.FULL,Locale.ENGLISH) %></option><% } %></select></div><div class="mini-grid"><div class="field"><label for="startTime">Starts</label><input type="time" id="startTime" name="startTime" value="<%= editing==null?"09:00":UI.e(editing.getStartTime()) %>" required></div><div class="field"><label for="endTime">Ends</label><input type="time" id="endTime" name="endTime" value="<%= editing==null?"17:00":UI.e(editing.getEndTime()) %>" required></div></div><div class="field"><label for="slotMinutes">Appointment duration</label><select name="slotMinutes" id="slotMinutes"><% for(int m:new int[]{10,15,20,30,45,60}){ %><option value="<%= m %>" <%= editing!=null&&editing.getSlotMinutes()==m?"selected":"" %>><%= m %> minutes</option><% } %></select></div><button class="button primary">Save session</button><% if(editing!=null){ %><a href="availability" class="text-link">Cancel editing</a><% } %></div></form><% } %><div class="tip"><h3>Weekly, recurring availability</h3><p>Slots follow these sessions each week. Changes do not cancel existing appointments. Review future bookings before changing hours.</p></div></aside></div>
<%@ include file="/WEB-INF/views/foot.jspf" %>
