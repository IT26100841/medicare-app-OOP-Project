<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Doctor profile");request.setAttribute("nav","doctors"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% Doctor d=(Doctor)request.getAttribute("doctor");if(d==null)d=DAOFactory.getDoctorDAO().getDoctorById(request.getParameter("id"));if(d==null)throw new IllegalArgumentException("Doctor not found"); %>
<div class="page-heading"><div><div class="eyebrow">CARE TEAM</div><h1>Doctor profile</h1><p>Professional details and available clinic sessions.</p></div><div class="heading-actions"><a class="button" href="doctor?action=list">Back to doctors</a></div></div><div class="form-grid"><section class="panel"><div class="profile-head"><span class="avatar blue"><%= UI.e(UI.initials(d.getName())) %></span><div><div class="card-number"><%= UI.e(d.getId()) %></div><h2><%= UI.e(d.getName()) %></h2><p><%= UI.e(d.getSpecialization()) %> · <%= UI.e(d.getQualification()) %></p></div></div><div class="panel-section"><dl class="detail-grid"><div><dt>Phone</dt><dd><%= UI.e(d.getPhone()) %></dd></div><div><dt>Email</dt><dd><%= UI.e(d.getEmail()) %></dd></div><div><dt>Consultation fee</dt><dd><%= UI.money(d.getConsultationFee()) %></dd></div></dl></div><div class="panel-section"><h3>Weekly clinic sessions</h3><% boolean any=false;for(Availability a:new ScheduleService().list())if(a.getDoctorId().equals(d.getId())){any=true; %><div class="schedule-item"><span class="schedule-time"><%= DayOfWeek.of(a.getDayOfWeek()).toString().substring(0,3) %></span><span class="schedule-detail"><strong><%= UI.e(UI.time(a.getStartTime())) %> – <%= UI.e(UI.time(a.getEndTime())) %></strong><small><%= a.getSlotMinutes() %> minute appointments</small></span></div><% }if(!any){ %><p>No published sessions. Ask an administrator to add availability.</p><% } %></div></section><aside><section class="panel"><div class="panel-body stack"><a class="button" href="availability">View clinic schedules</a><% if(isAdmin){ %><a class="button primary" href="doctor?action=edit&id=<%= java.net.URLEncoder.encode(d.getId(),"UTF-8") %>">Edit profile</a><% } %></div></section></aside></div>
<%@ include file="/WEB-INF/views/foot.jspf" %>
