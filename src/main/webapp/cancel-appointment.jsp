<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Cancel appointment");request.setAttribute("nav","appointments"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% Appointment a=(Appointment)request.getAttribute("appointment");if(a==null)throw new IllegalArgumentException("Select an appointment to cancel"); %>
<div class="page-heading"><div><div class="eyebrow">APPOINTMENTS</div><h1>Cancel this appointment?</h1><p>The appointment stays in the history and its time slot becomes available again.</p></div><div class="heading-actions"></div></div><section class="panel" style="max-width:720px"><div class="panel-body"><h2><%= UI.e(a.getPatientName()) %></h2><p><%= UI.e(a.getDoctorName()) %> · <%= UI.e(UI.date(a.getAppointmentDate())) %> at <%= UI.e(UI.time(a.getAppointmentTime())) %></p><div class="notice info">Use cancellation when a patient cannot attend. Use rescheduling to move a booked visit to another time.</div></div><form action="appointment" method="post"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="<%= a.getAppointmentId() %>"><div class="form-actions"><a class="button" href="appointment?action=list">Keep appointment</a><button class="button danger">Cancel appointment</button></div></form></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
