<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Appointments");request.setAttribute("nav","appointments"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Appointment> visits=UI.visibleAppointments(viewer);String requestedStatus=request.getParameter("status");if(requestedStatus!=null&&!requestedStatus.equalsIgnoreCase("ALL"))visits.removeIf(a->!a.getStatus().equalsIgnoreCase(requestedStatus)); %>
<div class="page-heading"><div><div class="eyebrow">PATIENT FLOW</div><h1>Appointments</h1><p>From booking to checkout. Keep every visit moving.</p></div><div class="heading-actions"><% if(isReception){ %><a class="button primary" href="appointment?action=new"><%= UI.icon("plus") %>Book appointment</a><% } %></div></div><% if("DOCTOR".equals(viewer.getRole())&&ClinicStore.doctorFor(viewer.getId())==null){ %><div class="notice info">Your account is not linked to a doctor yet. Ask an administrator to set the doctor profile in Team & access.</div><% } %><section class="panel" data-table><div class="panel-head"><h2>Appointment directory <span class="count"><%= visits.size() %></span></h2><span class="small-label">LIVE WORKSPACE</span></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search patient, doctor or visit number" aria-label="Search patient, doctor or visit number"></label><div class="filters"><button class="filter active" type="button" data-filter="all" aria-pressed="true">All</button><button class="filter " type="button" data-filter="Booked" aria-pressed="false">Booked</button><button class="filter " type="button" data-filter="Checked-in" aria-pressed="false">Waiting</button><button class="filter " type="button" data-filter="In consultation" aria-pressed="false">In consultation</button><button class="filter " type="button" data-filter="Completed" aria-pressed="false">Completed</button><button class="filter " type="button" data-filter="Cancelled" aria-pressed="false">Cancelled</button></div></div><% if(visits.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>Your schedule starts here.</h3><p>Register a patient, publish a doctor schedule, then book the first visit.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Date & time</th><th>Status</th><th>Next step</th></tr></thead><tbody><%@ include file="/WEB-INF/views/visit-rows.jspf" %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
