<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Insurance claims");request.setAttribute("nav","claims"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>

<div class="page-heading"><div><div class="eyebrow">PATIENT ADMINISTRATION</div><h1>Keep insurance paperwork moving.</h1><p>Record claim requests and track their review status.</p></div><div class="heading-actions"></div></div><div class="form-grid"><section class="panel" data-table><div class="panel-head"><h2>Claim register</h2></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search patient, insurer or policy" aria-label="Search patient, insurer or policy"></label><div class="filters"><button class="filter active" type="button" data-filter="all" aria-pressed="true">All</button><button class="filter " type="button" data-filter="Pending" aria-pressed="false">Pending</button><button class="filter " type="button" data-filter="Approved" aria-pressed="false">Approved</button><button class="filter " type="button" data-filter="Rejected" aria-pressed="false">Rejected</button></div></div><div class="table-wrap"><table><thead><tr><th>Patient / claim</th><th>Provider / policy</th><th>Amount</th><th>Status</th><th>Review</th></tr></thead><tbody><% boolean any=false;try(java.sql.ResultSet rs=PortalData.query("insurance_claims")){while(rs.next()){any=true; %><tr data-row data-status="<%= UI.e(rs.getString("status")) %>"><td><strong><%= UI.e(UI.patient(rs.getString("patient_id"))) %></strong><span class="secondary">Claim #<%= rs.getInt("claim_id") %></span></td><td><%= UI.e(rs.getString("provider_name")) %><span class="secondary"><%= UI.e(rs.getString("policy_number")) %></span></td><td class="amount"><%= UI.money(rs.getDouble("claim_amount")) %></td><td><%= UI.badge(rs.getString("status")) %></td><td><% if(isAdmin&&"Pending".equals(rs.getString("status"))){ %><form action="insurance-claim" method="post" class="row-actions"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="updateStatus"><input type="hidden" name="claimId" value="<%= rs.getInt("claim_id") %>"><select name="status" aria-label="Claim decision"><option>Approved</option><option>Rejected</option></select><button class="button small">Save</button></form><% }else{ %><span class="secondary">No action needed</span><% } %></td></tr><% }} %></tbody></table></div><% if(!any){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>No claims recorded.</h3><p>Create a claim request when a patient provides insurance details.</p></div><% } %><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div></section><aside><% if(isReception){ %><form action="insurance-claim" method="post" class="panel"><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="create"><div class="panel-head"><h2>New claim request</h2></div><div class="panel-body stack"><div class="field"><label for="patientId">Patient</label><select name="patientId" id="patientId" required><option value="">Choose patient</option><% for(Patient p:DAOFactory.getPatientDAO().getAllPatients()){ %><option value="<%= UI.e(p.getId()) %>"><%= UI.e(p.getName()) %></option><% } %></select></div><div class="field"><label for="provider">Insurance provider</label><input id="provider" name="providerName" maxlength="100" required></div><div class="field"><label for="policy">Policy number</label><input id="policy" name="policyNumber" maxlength="100" required></div><div class="field"><label for="claimAmount">Claim amount (LKR)</label><input type="number" id="claimAmount" name="claimAmount" min="0" step="0.01" required></div><button class="button primary">Create claim</button></div></form><% } %><div class="tip"><h3>A local claim register</h3><p>Approval here records the clinic’s review. It does not submit a request to an insurer or confirm external reimbursement.</p></div></aside></div>
<%@ include file="/WEB-INF/views/foot.jspf" %>
