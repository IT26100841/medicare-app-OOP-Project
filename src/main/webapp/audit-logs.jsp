<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Activity log");request.setAttribute("nav","audit"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>

<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>A record of important actions.</h1><p>Review sign-ins, workflow changes and administrative activity.</p></div><div class="heading-actions"></div></div><section class="panel" data-table><div class="panel-head"><h2>Workspace activity</h2></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search user, role or action" aria-label="Search user, role or action"></label><div class="filters"></div></div><div class="table-wrap"><table><thead><tr><th>Team member</th><th>Role</th><th>Action</th><th>Time</th></tr></thead><tbody><% try(java.sql.ResultSet rs=PortalData.query("audit_logs")){while(rs.next()){ %><tr data-row><td><%= UI.e(rs.getString("username")) %></td><td><%= UI.badge(rs.getString("user_role")) %></td><td class="pre-wrap" style="max-width:480px"><%= UI.e(rs.getString("action")) %></td><td><%= UI.e(rs.getTimestamp("timestamp")) %></td></tr><% }} %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
