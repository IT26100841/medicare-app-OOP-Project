<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Team & access");request.setAttribute("nav","users"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<User> users=DAOFactory.getUserDAO().getAllUsers(); %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>The right access for every role.</h1><p>Manage hospital accounts and connect clinician logins to doctor profiles.</p></div><div class="heading-actions"><a class="button primary" href="users?action=new"><%= UI.icon("plus") %>Add team member</a></div></div><section class="panel" data-table><div class="panel-head"><h2>Team accounts <span class="count"><%= users.size() %></span></h2></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search username, role or email" aria-label="Search username, role or email"></label><div class="filters"></div></div><div class="table-wrap"><table><thead><tr><th>Team member</th><th>Role</th><th>Linked doctor</th><th>Actions</th></tr></thead><tbody><% for(User u:users){String doctor=ClinicStore.doctorFor(u.getId()); %><tr data-row><td><div class="person"><span class="avatar"><%= UI.e(UI.initials(u.getUsername())) %></span><span><strong><%= UI.e(u.getUsername()) %></strong><small><%= UI.e(u.getEmail()) %></small></span></div></td><td><%= UI.badge("STAFF".equals(u.getRole())?"Reception":u.getRole()) %></td><td><%= UI.e(doctor==null?"—":UI.doctor(doctor)) %></td><td><div class="row-actions"><a class="button small" href="users?action=edit&id=<%= u.getId() %>">Edit access</a><% if(u.getId()!=viewer.getId()){ %><form action="users" method="post" data-confirm="Delete this login account? The doctor's clinical records are retained."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%= u.getId() %>"><button class="button small danger">Delete</button></form><% } %></div></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
