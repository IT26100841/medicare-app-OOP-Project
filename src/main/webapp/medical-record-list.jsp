<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Clinical records");request.setAttribute("nav","records"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<MedicalRecord> records=DAOFactory.getMedicalRecordDAO().getAllMedicalRecords();if("DOCTOR".equals(viewer.getRole())){String linked=ClinicStore.doctorFor(viewer.getId());records.removeIf(r->!Objects.equals(r.getDoctorId(),linked));} %>
<div class="page-heading"><div><div class="eyebrow">CLINICAL WORKSPACE</div><h1>A clearer picture of every consultation.</h1><p>Save observations and prescription notes, then complete the visit.</p></div><div class="heading-actions"><% if(isClinical){ %><a class="button primary" href="medical-record?action=new"><%= UI.icon("plus") %>Add clinical record</a><% } %></div></div><section class="panel" data-table><div class="panel-head"><h2>Consultation records <span class="count"><%= records.size() %></span></h2></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search patient, doctor or diagnosis" aria-label="Search patient, doctor or diagnosis"></label><div class="filters"></div></div><% if(records.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>Your clinical notes belong here.</h3><p>Start a checked-in consultation from Appointments, then add a clinical note.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Diagnosis / note</th><th>Recorded</th><th>Actions</th></tr></thead><tbody><% for(MedicalRecord r:records){ %><tr data-row><td><strong><%= UI.e(UI.patient(r.getPatientId())) %></strong><span class="secondary">Record #<%= r.getRecordId() %> · Visit <%= r.getAppointmentId()>0?"#"+r.getAppointmentId():"not linked" %></span></td><td><%= UI.e(UI.doctor(r.getDoctorId())) %></td><td style="white-space:normal;max-width:260px"><%= UI.e(r.getDiagnosis()) %></td><td><%= UI.e(UI.date(r.getRecordDate())) %></td><td><div class="row-actions"><a class="button small" href="download-prescription?id=<%= r.getRecordId() %>" target="_blank" rel="noopener">Print note</a><% if(isClinical){ %><a class="button small" href="medical-record?action=edit&id=<%= r.getRecordId() %>">Edit</a><form action="medical-record" method="post" data-confirm="Delete this clinical record? Completed visits must retain at least one clinical record."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%= r.getRecordId() %>"><button class="button small danger">Delete</button></form><% } %></div></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
