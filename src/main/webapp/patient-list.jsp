<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.medicare.model.*,com.medicare.service.*,com.medicare.factory.DAOFactory,com.medicare.util.*,java.util.*,java.time.*" %>
<% request.setAttribute("pageTitle","Patients");request.setAttribute("nav","patients"); %>
<%@ include file="/WEB-INF/views/head.jspf" %>
<% List<Patient> patients=DAOFactory.getPatientDAO().getAllPatients(); %>
<div class="page-heading"><div><div class="eyebrow">PATIENT DIRECTORY</div><h1>People at the heart of care.</h1><p>Contact details, clinical history and upcoming visits in one place.</p></div><div class="heading-actions"><% if(isReception){ %><a class="button primary" href="add-patient.jsp"><%= UI.icon("plus") %>Register patient</a><% } %></div></div><section class="panel" data-table><div class="panel-head"><h2>All patients <span class="count"><%= patients.size() %></span></h2><span class="small-label">PATIENT DIRECTORY</span></div><div class="toolbar"><label class="search-field"><%= UI.icon("search") %><input data-search type="search" placeholder="Search name, patient ID or contact" aria-label="Search name, patient ID or contact"></label><div class="filters"></div></div><% if(patients.isEmpty()){ %><div class="empty-state"><div class="empty-icon"><%= UI.icon("file") %></div><h3>Your patient directory is ready.</h3><p>Register your first patient to begin booking appointments.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Contact</th><th>Age / gender</th><th>Blood group</th><th>Actions</th></tr></thead><tbody><% for(Patient p:patients){ %><tr data-row><td><div class="person"><span class="avatar"><%= UI.e(UI.initials(p.getName())) %></span><span><strong><%= UI.e(p.getName()) %></strong><small><%= UI.e(p.getId()) %></small></span></div></td><td><%= UI.e(p.getContact()) %><span class="secondary"><%= UI.e(p.getEmail()) %></span></td><td><%= p.getAge() %> years<span class="secondary"><%= UI.e(p.getGender()) %></span></td><td><span class="badge"><%= UI.e(p.getBloodGroup()) %></span></td><td><div class="row-actions"><a class="button small" href="patient?action=view&id=<%= java.net.URLEncoder.encode(p.getId(),"UTF-8") %>">View profile</a><% if(isReception){ %><a class="button small" href="edit-patient?id=<%= java.net.URLEncoder.encode(p.getId(),"UTF-8") %>">Edit</a><% }if(isAdmin){ %><form action="delete-patient" method="post" data-confirm="Delete this patient? Patients linked to clinical, billing or appointment records cannot be deleted."><input type="hidden" name="csrfToken" value="<%= UI.e(session.getAttribute("csrfToken")) %>"><input type="hidden" name="id" value="<%= UI.e(p.getId()) %>"><button class="button small danger">Delete</button></form><% } %></div></td></tr><% } %></tbody></table></div><div class="no-results" hidden>No matching records. Try another search.</div><div class="table-footer"><span data-count></span><div class="pagination"><button type="button" data-prev aria-label="Previous page">←</button><button type="button" data-next aria-label="Next page">→</button></div></div><% } %></section>
<%@ include file="/WEB-INF/views/foot.jspf" %>
